# ==============================================================================
# RunSafe Environment Configuration (.env.example)
# NEVER commit .env files containing real secrets to version control.
# ==============================================================================

# Fastify Control Plane Configuration
PORT=4000
HOST=127.0.0.1
NODE_ENV=development

# TrueForge Local Runtime
TRUEFORGE_URL=http://localhost:8790
RUNSAFE_AGENT_NAME=runsafe-agent

# RunSafe Remote MCP Server Configuration
MCP_SERVER_PORT=4001
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_NAME=runsafe-mcp
MCP_SERVER_URL=http://127.0.0.1:4001/sse

# Organizer-Provided Model Provider (Configured in TrueForge)
# When provided by hackathon organizers, set key here or paste in TrueForge UI:
OPENAI_API_KEY=

# Local Model Fallback (Ollama on localhost:11434)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL_ID=qwen3:4b-instruct-2507-q4_K_M

# Daytona Sandbox Provider (Configured in TrueForge)
# When provided by hackathon organizers, set key here:
DAYTONA_API_KEY=
