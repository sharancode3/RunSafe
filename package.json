{
  "name": "runsafe",
  "version": "0.1.0",
  "private": true,
  "description": "RunSafe - Verified Autonomous SRE Incident Recovery Control Plane",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "tsc --build --noEmit",
    "test": "vitest run",
    "dev:control-plane": "tsx apps/control-plane/src/server.ts",
    "dev:mcp": "tsx packages/mcp-server/src/server.ts",
    "stage1:verify": "tsx scripts/stage1_verify.ts"
  },
  "devDependencies": {
    "@types/node": "^24.11.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  }
}
